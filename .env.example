# Copy to .env (never commit .env). The defaults below run fully offline: no keys, no DB.

# ---- implementation switches ("dev switches") ---------------------------------------------
STORE=memory            # memory | mongo
RETRIEVER=fake          # fake (keyword search) | real (hybrid, partner's work)
INGESTOR=fake           # fake (clones demo fixture) | real (PDF parsing, partner's work)
EMBEDDER=hash           # hash (offline test stub) | bge (real local model)
LLM_PROVIDER=mock       # mock | openai_compat
FILE_STORE=local        # local (a folder; wiped on free hosts) | mongo (PDFs in MongoDB GridFS)

# ---- MongoDB (only when STORE=mongo) ------------------------------------------------------
# Local:  make db   (mongodb-atlas-local docker image)
# Cloud:  MongoDB Atlas free tier (M0) connection string
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=verity

# ---- LLM (only when LLM_PROVIDER=openai_compat) ---------------------------------------------
# Any OpenAI-compatible endpoint works. See docs/LLM_PROVIDERS.md for free options.
# Model ids on free tiers change often: check the provider's model list before you debug.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MAIN_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# thinking models need an effort or short replies can come back empty (per role):
LLM_MAIN_REASONING_EFFORT=low
LLM_FAST_REASONING_EFFORT=low
# list the models your key can use right now:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"

# Judge should be a DIFFERENT model family than the generator (a model grades itself too kindly).
# Recommended: Qwen on Groq (different family from gpt-oss, no thinking tokens, same key):
# LLM_JUDGE_BASE_URL=https://api.groq.com/openai/v1
# LLM_JUDGE_API_KEY=
# LLM_JUDGE_MODEL=qwen/qwen3.8-27b
# NOTE: Gemini 2.5 Flash's free tier is only 20 requests PER DAY per model: too few for evals.

# pace requests per minute per role to stay under free-tier limits (blank = no limit)
# LLM_JUDGE_RPM=8
# LLM_MAIN_RPM=20
LLM_CACHE=true          # cache completions on disk: saves free-tier quota when re-running evals

# ---- app --------------------------------------------------------------------------------
TOP_K=6
CORS_ORIGINS=http://localhost:5173
